# Local development defaults.
API_HOST=127.0.0.1
API_PORT=3000
VITE_API_URL=http://127.0.0.1:3000

# Intron/Sahara powers the opt-in local voice flow and its separate smoke test.
# Never expose this key through a VITE_ variable or commit a real value.
INTRON_API_KEY=
INTRON_STT_BASE_URL=https://infer.voice.intron.io
INTRON_STT_LANGUAGE=yo

# Optional OpenAI STT smoke test. Never commit a real key.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Optional Deepgram prerecorded STT smoke test. Never commit a real key.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_BASE_URL=https://api.deepgram.com
DEEPGRAM_STT_MODEL=nova-3
# Primary benchmark baseline: explicit multilingual mode; not a Yoruba-support claim.
DEEPGRAM_STT_LANGUAGE=multi
# Keep false for primary WER; true is a separate formatting experiment.
DEEPGRAM_STT_SMART_FORMAT=false

# Optional for Hugging Face dataset metadata access; never committed or recorded.
HF_TOKEN=
